{
  "name": "vps-infra-public",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "author": "Alex Smolvin HouseOfHeisenberg@atomicmail.io (smolvin.com)",
  "repository": {
    "type": "git",
    "url": "https://github.com/Smolvin/vps-public"
  },
  "description": "Public, reusable dev-onboarding scripts (macOS + Windows): isolated non-admin profile + a basic dev toolset. Scripts and documentation only, no npm dependencies.",
  "scripts": {
    "mac:profiles": "sudo scripts/09_create_profiles.sh",
    "mac:profiles:apply": "sudo scripts/09_create_profiles.sh --apply",
    "mac:dev-tools": "bash scripts/06_setup_new_dev_mac.sh",
    "mac:dev-tools:check": "bash scripts/06_setup_new_dev_mac.sh --check",
    "mac:dev-tools:inventory": "bash scripts/06_setup_new_dev_mac.sh --inventory",
    "mac:git-identities": "bash scripts/14_setup_git_identities.sh",
    "mac:git-identities:apply": "bash scripts/14_setup_git_identities.sh --apply",
    "mac:shell": "bash scripts/15_setup_shell_and_macos.sh",
    "mac:shell:apply": "bash scripts/15_setup_shell_and_macos.sh --apply",
    "lint:scripts": "shellcheck scripts/*.sh"
  }
}
